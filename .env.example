# ==============================================================================
# WooCommerce Management & CRM Platform - Production Environment Template
# ==============================================================================
# IMPORTANT: This file contains only configuration examples. Do not put real secrets here.
# During initial setup, the Web Installer (/install) will automatically generate
# strong random keys and create your production .env file.
# ==============================================================================

# Application Configuration
APP_NAME="WooCommerce Management & CRM"
APP_ENV=production
APP_DEBUG=false
APP_URL=https://crm.yourdomain.com
APP_SECRET=replace_with_strong_random_secret_at_least_32_characters
ENCRYPTION_KEY=replace_with_64_character_hex_encryption_key
CRON_SECRET=replace_with_strong_random_secret_for_cron_url_calls

# Database Configuration (MariaDB 10.6+ / MySQL 8.0+)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=your_production_database_name
DB_USERNAME=your_production_database_user
DB_PASSWORD="your_production_database_password"
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

# Session Security Configuration
SESSION_LIFETIME=7200
SESSION_SECURE=true
SESSION_SAME_SITE=Lax

# Regional and Localization Settings
TIMEZONE=Asia/Tehran
LOCALE=fa
APP_VERSION=1.1.0
 
# Voluntary Developer Donation Settings (Optional)
DONATE_RECIPIENT_NAME=
DONATE_CARD_NUMBER=
DONATE_EMAIL=
DONATE_GITHUB=
